/* 
 * Project Title: ESP32 Blynk Payment Announcer (Text-to-Speech + I2C LCD)
 *
 * LCD wiring (I2C):
 *   VCC -> 5V (or 3.3V depending on your module)
 *   GND -> GND
 *   SDA -> GPIO 21 (ESP32 default SDA)
 *   SCL -> GPIO 22 (ESP32 default SCL)
 *
 * Library needed: "LiquidCrystal I2C" by Frank de Brabander (install via Library Manager)
 * If your screen doesn't show text, scan for its I2C address (commonly 0x27 or 0x3F)
 * using an I2C scanner sketch and update LCD_ADDR below.
 */

// ---------- Blynk credentials (MUST be defined before includes) ----------
#define BLYNK_TEMPLATE_ID ""
#define BLYNK_TEMPLATE_NAME ""
#define BLYNK_AUTH_TOKEN    ""

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include <Talkie.h>
#include "Vocab_US_Large.h"
#include "Vocab_US_TI99.h"
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

Talkie voice;

// ---------- LCD setup ----------
#define LCD_ADDR 0x27   // change to 0x3F if your module uses that address
#define LCD_COLS 16
#define LCD_ROWS 2
LiquidCrystal_I2C lcd(LCD_ADDR, LCD_COLS, LCD_ROWS);

// ---------- WiFi credentials ----------
const char* ssid     = "";
const char* password = "";

struct WordMap {
