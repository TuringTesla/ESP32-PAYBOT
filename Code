const int wordCount = sizeof(words) / sizeof(words[0]);

// ---------- LCD helper functions ----------
void lcdShowIdle() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("waiting for");
  lcd.setCursor(0, 1);
  lcd.print("payment.....");
}

void lcdShowAmount(int amount) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Received :");
  lcd.setCursor(0, 1);
  lcd.print("Rs");
  lcd.setCursor(4, 1);
  lcd.print(amount);
}

// Function to look up and speak a single word
void speakWord(const char* w) {
  for (int i = 0; i < wordCount; i++) {
    if (strcasecmp(w, words[i].text) == 0) {
      voice.say(words[i].lpc);
      return;
    }
  }
  Serial.print("Word not found in vocab: ");
  Serial.println(w);
}

// Function to announce single numbers/digits
void speakNumber(int num) {
  switch(num) {
    case 0: speakWord("0"); break;
    case 1: speakWord("1"); break;
    case 2: speakWord("2"); break;
    case 3: speakWord("3"); break;
    case 4: speakWord("4"); break;
    case 5: speakWord("5"); break;
    case 6: speakWord("6"); break;
    case 7: speakWord("7"); break;
    case 8: speakWord("8"); break;
    case 9: speakWord("9"); break;
  }
}

// Handler executed whenever new data arrives on Virtual Pin V0
BLYNK_WRITE(V0) {
  String data = param.asStr();
  data.trim();

  if (data.length() == 0) return;

  // Split incoming string into words
  String parsedWords[50];
  int parsedCount = 0;
  int start = 0;
  int spaceIndex = data.indexOf(' ');

  while (spaceIndex != -1 && parsedCount < 50) {
    parsedWords[parsedCount++] = data.substring(start, spaceIndex);
    start = spaceIndex + 1;
    spaceIndex = data.indexOf(' ', start);
  }
  if (start < data.length() && parsedCount < 50) {
    parsedWords[parsedCount++] = data.substring(start);
  }

  // Extract payment value (expects value at array index 2 or index 0 fallback)
  String valueStr = (parsedCount >= 3) ? parsedWords[2] : parsedWords[0];
  valueStr.replace(",", "");
  int fullValue = valueStr.toInt();

  // Breakdown digits
  int thousandsPart = fullValue / 1000;
  int restPart      = fullValue % 1000;

  int thTens = (thousandsPart / 10) % 10;
  int thOnes = thousandsPart % 10;

  int hHund = restPart / 100;
  int hTens = (restPart / 10) % 10;
  int hOnes = restPart % 10;

  // Serial debug logging
  Serial.print("Incoming Payment: ");
  Serial.println(fullValue);

  // LCD: show the amount received
  lcdShowAmount(fullValue);

  // Audio Speech sequence
  speakWord("YOU");
  speakWord("GOT");

  if (thousandsPart > 0) {
    if (thTens > 0) speakNumber(thTens);
    if (thOnes > -1) speakNumber(thOnes);
    speakWord("1000");
  }

  if (restPart > 0) {
    if (hHund > 0) {
      speakNumber(hHund);
      speakWord("100");
    }
    if (hTens > -1) speakNumber(hTens);
    if (hOnes > -1) speakNumber(hOnes);
  }

  // Clear virtual pin after processing
  Blynk.virtualWrite(V0, "");

  // Hold the amount on screen briefly, then go back to the idle message
  delay(4000);
  lcdShowIdle();
}

BLYNK_CONNECTED() {
  Serial.println("Connected to Blynk Cloud!");
  Blynk.syncVirtual(V0);

  // Only now switch away from the "ESP32 Pay bot" splash screen
  lcdShowIdle();
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("Starting ESP32 Blynk Payment Announcer...");

  // LCD init - splash stays on screen until BLYNK_CONNECTED() fires
  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("ESP32 Pay bot");

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, password);
}

void loop() {
  Blynk.run();
}
